{
  "name": "BugBot - Create Issue",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "bugbot/create-issue",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-create-issue",
      "name": "Webhook: create-issue",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [160, 300],
      "webhookId": "bugbot-create-issue"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.body.confirmed }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-confirmed",
      "name": "Is Confirmed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [380, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"ok\": false,\n  \"error\": \"confirmation_required\",\n  \"spoken\": \"I need a yes from you before I file this.\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-unconfirmed",
      "name": "Respond: Not Confirmed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [600, 480]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.body.append_to }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "if-append",
      "name": "Append to Existing?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [600, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.github.com/repos/aryanSharma48/smoothapi/issues/{{ $('Webhook: create-issue').first().json.body.append_to }}/comments",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ body: '**Additional context from voice report:**\\n\\n' + ($('Webhook: create-issue').first().json.body.description || '') + '\\n\\n**Steps:** ' + ($('Webhook: create-issue').first().json.body.steps_to_reproduce || 'N/A') }) }}",
        "options": {}
      },
      "id": "github-append-comment",
      "name": "GitHub: Append Comment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [820, 160]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({\n  ok: true,\n  created: false,\n  number: $('Webhook: create-issue').first().json.body.append_to,\n  spoken: 'Added your details to issue ' + $('Webhook: create-issue').first().json.body.append_to + '.'\n}) }}",
        "options": {}
      },
      "id": "respond-appended",
      "name": "Respond: Appended",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1040, 160]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/repos/aryanSharma48/smoothapi/issues?state=open&per_page=30",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "options": {
          "alwaysOutputData": true
        }
      },
      "id": "github-get-open-issues",
      "name": "GitHub: Get Open Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [820, 340]
    },
    {
      "parameters": {
        "jsCode": "const b = $('Webhook: create-issue').first().json.body || {};\nconst openIssues = $input.all().map(i => i.json).filter(i => i && i.number && !i.pull_request);\n\n// Check duplicate based on title similarity / token matching\nlet duplicate = null;\nif (!b.force_create && b.title) {\n  const words = b.title.toLowerCase().split(/\\s+/).filter(w => w.length > 3);\n  for (const existing of openIssues) {\n    const exTitle = (existing.title || '').toLowerCase();\n    const matchCount = words.filter(w => exTitle.includes(w)).length;\n    if (matchCount >= 2 || (words.length === 1 && exTitle.includes(words[0]))) {\n      duplicate = { number: existing.number, title: existing.title };\n      break;\n    }\n  }\n}\n\n// Determine severity & component\nconst validSevs = ['low', 'medium', 'high', 'critical'];\nconst sev = validSevs.includes(b.severity_hint) ? b.severity_hint : 'medium';\n\nconst validComps = ['typescript', 'python', 'docs', 'frontend', 'api', 'database'];\nconst comp = validComps.includes(b.component_hint) ? b.component_hint : 'typescript';\n\nconst body = [\n  '## Description', b.description || 'No description provided',\n  '## Steps to reproduce', b.steps_to_reproduce || '_not provided_',\n  '## Environment', b.environment || '_not provided_',\n  '---',\n  '_Filed automatically by VoiceBugBot_'\n].join('\\n\\n');\n\nreturn [{\n  json: {\n    duplicate,\n    title: b.title,\n    body,\n    sev,\n    comp,\n    labels: ['reported', `sev:${sev}`, `comp:${comp}`]\n  }\n}];"
      },
      "id": "code-triage",
      "name": "Triage & Check Duplicate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1040, 340]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.duplicate !== null }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-duplicate",
      "name": "Is Duplicate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1240, 340]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({\n  ok: true,\n  created: false,\n  duplicate_of: $json.duplicate,\n  spoken: 'This looks like issue ' + $json.duplicate.number + ', ' + $json.duplicate.title + '. Add to it, or file a new one?'\n}) }}",
        "options": {}
      },
      "id": "respond-duplicate",
      "name": "Respond: Duplicate Found",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1460, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/aryanSharma48/smoothapi/issues",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: $('Triage & Check Duplicate').first().json.title, body: $('Triage & Check Duplicate').first().json.body, labels: $('Triage & Check Duplicate').first().json.labels }) }}",
        "options": {}
      },
      "id": "github-create-issue",
      "name": "GitHub: Create Issue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1460, 420]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({\n  ok: true,\n  created: true,\n  number: $json.number,\n  url: $json.html_url,\n  labels: $('Triage & Check Duplicate').first().json.labels,\n  spoken: 'Filed issue ' + $json.number + ', ' + $('Triage & Check Duplicate').first().json.sev + ' severity, ' + $('Triage & Check Duplicate').first().json.comp + '. Want me to start a fix?'\n}) }}",
        "options": {}
      },
      "id": "respond-created",
      "name": "Respond: Issue Created",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1680, 420]
    }
