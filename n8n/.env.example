# Public Webhook URL (Must match your ngrok static domain or Cloudflare Tunnel)
# e.g., https://your-domain.ngrok-free.app/
WEBHOOK_URL=https://your-subdomain.ngrok-free.app/

# Timezone
TIMEZONE=Asia/Kolkata

# Shared secret between ElevenLabs, GitHub Actions, and n8n (used in x-bugbot-secret header)
N8N_SHARED_SECRET=your_32_char_random_hex_secret_here

# Target GitHub Repository
GITHUB_REPO=aryanSharma48/smoothapi

# GitHub Personal Access Token (Fine-grained, with Issues read/write, Actions read/write, PRs read/write)
GITHUB_TOKEN=github_pat_xxxx

# Google AI Studio Gemini API Key
GEMINI_API_KEY=AIzaxxxx

# Optional ngrok container credentials (if using docker compose --profile tunnel up)
NGROK_AUTHTOKEN=your_ngrok_authtoken
NGROK_DOMAIN=your-subdomain.ngrok-free.app
